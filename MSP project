<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MSP Bots</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#050607;
    color:#fff;
    overflow-x:hidden;
}

body::before{
    content:"";
    position:fixed;
    inset:0;
    z-index:-3;
    background:
        radial-gradient(circle at 20% 20%,rgba(0,255,204,.13),transparent 30%),
        radial-gradient(circle at 80% 70%,rgba(0,140,255,.10),transparent 30%),
        #050607;
}

.grid{
    position:fixed;
    inset:0;
    z-index:-2;
    opacity:.13;
    background-image:
        linear-gradient(rgba(0,255,204,.18) 1px,transparent 1px),
        linear-gradient(90deg,rgba(0,255,204,.18) 1px,transparent 1px);
    background-size:50px 50px;
    animation:gridMove 12s linear infinite;
}

@keyframes gridMove{
    from{transform:translateY(0)}
    to{transform:translateY(50px)}
}

/* NAVBAR */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:72px;
    z-index:1000;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 7%;
    background:rgba(5,6,7,.78);
    backdrop-filter:blur(18px);
    border-bottom:1px solid rgba(0,255,204,.12);
}

.logo{
    font-size:25px;
    font-weight:900;
    letter-spacing:2px;
    color:#00ffcc;
}

.logo span{
    color:#fff;
}

.nav-links{
    display:flex;
    gap:30px;
    list-style:none;
}

.nav-links a{
    color:#aaa;
    text-decoration:none;
    transition:.3s;
}

.nav-links a:hover{
    color:#00ffcc;
}

.nav-button{
    text-decoration:none;
    color:#000;
    background:#00ffcc;
    padding:11px 19px;
    border-radius:9px;
    font-weight:bold;
    transition:.3s;
}

.nav-button:hover{
    transform:translateY(-2px);
    box-shadow:0 0 25px rgba(0,255,204,.4);
}

/* HERO */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:130px 20px 80px;
}

.hero-content{
    max-width:900px;
}

.badge{
    display:inline-block;
    padding:8px 15px;
    border:1px solid rgba(0,255,204,.35);
    background:rgba(0,255,204,.06);
    border-radius:50px;
    color:#00ffcc;
    font-size:13px;
    margin-bottom:25px;
}

.hero h1{
    font-size:clamp(55px,10vw,105px);
    line-height:.95;
    font-weight:1000;
    letter-spacing:-5px;
}

.hero h1 span{
    color:#00ffcc;
    text-shadow:0 0 35px rgba(0,255,204,.35);
}

.hero p{
    color:#999;
    font-size:18px;
    max-width:650px;
    margin:30px auto;
    line-height:1.7;
}

.hero-buttons{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    padding:15px 25px;
    border-radius:10px;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
    cursor:pointer;
    border:none;
    display:inline-block;
}

.btn-primary{
    color:#000;
    background:#00ffcc;
}

.btn-primary:hover{
    transform:translateY(-3px);
    box-shadow:0 0 30px rgba(0,255,204,.35);
}

.btn-secondary{
    color:#fff;
    border:1px solid #333;
    background:#101214;
}

.btn-secondary:hover{
    border-color:#00ffcc;
    color:#00ffcc;
}

/* STATUS */

.status{
    margin:35px auto 0;
    width:max-content;
    display:flex;
    align-items:center;
    gap:10px;
    padding:10px 17px;
    border-radius:30px;
    background:#0c1010;
    border:1px solid #1b2927;
    color:#aaa;
    font-size:13px;
}

.dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:#00ff88;
    box-shadow:0 0 12px #00ff88;
}

/* SECTIONS */

section{
    padding:100px 7%;
}

.section-title{
    text-align:center;
    margin-bottom:55px;
}

.section-title small{
    color:#00ffcc;
    text-transform:uppercase;
    letter-spacing:3px;
}

.section-title h2{
    font-size:42px;
    margin-top:12px;
}

.section-title p{
    color:#777;
    margin-top:12px;
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    max-width:1100px;
    margin:auto;
}

.stat{
    padding:30px;
    background:rgba(14,17,18,.8);
    border:1px solid #1b2021;
    border-radius:18px;
    text-align:center;
    transition:.3s;
}

.stat:hover{
    transform:translateY(-5px);
    border-color:#00ffcc;
}

.stat h3{
    color:#00ffcc;
    font-size:35px;
}

.stat p{
    color:#777;
    margin-top:8px;
}

/* BOTS */

.bot-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.bot-card{
    padding:28px;
    border:1px solid #1b2021;
    background:linear-gradient(145deg,#0d1011,#080a0b);
    border-radius:20px;
    transition:.3s;
    position:relative;
    overflow:hidden;
}

.bot-card:hover{
    transform:translateY(-7px);
    border-color:#00ffcc;
}

.bot-icon{
    width:65px;
    height:65px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
    background:#101918;
    border:1px solid #173c35;
    margin-bottom:20px;
}

.bot-card h3{
    font-size:22px;
}

.bot-card p{
    color:#777;
    line-height:1.6;
    margin:12px 0 20px;
}

.bot-status{
    font-size:12px;
    color:#00ff88;
}

.bot-buttons{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-top:18px;
}

.small-btn{
    padding:9px 13px;
    border-radius:8px;
    text-decoration:none;
    font-size:12px;
    font-weight:bold;
    cursor:pointer;
    border:1px solid #252b2c;
    background:#101415;
    color:#aaa;
}

.small-btn:hover{
    border-color:#00ffcc;
    color:#00ffcc;
}

/* FEATURES */

.features{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.feature{
    padding:30px;
    border-radius:18px;
    background:#0b0e0f;
    border:1px solid #191e1f;
    transition:.3s;
}

.feature:hover{
    transform:translateY(-5px);
    border-color:#00ffcc;
}

.feature-icon{
    font-size:30px;
    margin-bottom:20px;
}

.feature h3{
    margin-bottom:10px;
}

.feature p{
    color:#777;
    line-height:1.6;
}

/* TEAM */

.team{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.member{
    text-align:center;
    padding:30px;
    border-radius:18px;
    background:#0b0e0f;
    border:1px solid #191e1f;
}

.avatar{
    width:80px;
    height:80px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:#101817;
    border:2px solid #00ffcc;
    font-size:30px;
}

.member h3{
    margin-top:18px;
}

.member p{
    color:#00ffcc;
    font-size:13px;
    margin-top:5px;
}

/* FAQ */

.faq{
    max-width:800px;
    margin:auto;
}

details{
    background:#0b0e0f;
    border:1px solid #1b2021;
    border-radius:12px;
    padding:20px;
    margin-bottom:12px;
}

summary{
    cursor:pointer;
    font-weight:bold;
}

details p{
    color:#777;
    line-height:1.6;
    padding-top:15px;
}

/* CTA */

.cta{
    max-width:1000px;
    margin:auto;
    padding:70px 30px;
    text-align:center;
    border-radius:25px;
    border:1px solid #1b3833;
    background:
        radial-gradient(circle at center,rgba(0,255,204,.1),transparent 60%),
        #090d0d;
}

.cta h2{
    font-size:45px;
    margin-bottom:15px;
}

.cta p{
    color:#777;
    margin-bottom:25px;
}

/* FOOTER */

footer{
    border-top:1px solid #161b1c;
    padding:40px 7%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    color:#555;
}

footer strong{
    color:#00ffcc;
}

footer a{
    color:#666;
    text-decoration:none;
    margin-left:20px;
}

footer a:hover{
    color:#00ffcc;
}

/* MOBILE */

@media(max-width:850px){

    nav{
        padding:0 20px;
    }

    .nav-links{
        display:none;
    }

    section{
        padding:80px 20px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .bot-grid,
    .features,
    .team{
        grid-template-columns:1fr;
    }

    .hero h1{
        letter-spacing:-3px;
    }

    footer{
        flex-direction:column;
        gap:20px;
        text-align:center;
    }
}

@media(max-width:480px){

    .stats{
        grid-template-columns:1fr;
    }

    .hero p{
        font-size:15px;
    }

    .section-title h2{
        font-size:32px;
    }

    .cta h2{
        font-size:32px;
    }
}
</style>
</head>

